---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Path of the page, e.g. "/app". Used for canonical + OG url. */
  path?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Write HTML, CSS and JavaScript and watch it run. A fast, private, in-browser playground with device previews, a console, share links and one-click export.',
  path = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121210" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HTML Runner" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@h190k" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme is resolved before paint to avoid a flash. Key: "html-runner:theme" = "light" | "dark". -->
    <script is:inline>
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('html-runner:theme');
        } catch {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="bg-paper text-ink">
    <slot />
  </body>
</html>
